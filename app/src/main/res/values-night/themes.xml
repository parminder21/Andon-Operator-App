<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark / Night theme -->
    <style name="Theme.AndonOperatorApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary remains same for brand consistency -->
        <item name="colorPrimary">@color/primary</item>              <!-- #3C0366 -->
        <item name="colorPrimaryVariant">@color/primary_light</item> <!-- #5C2A8C (lighter for contrast) -->
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary adapts to dark background -->
        <item name="colorSecondary">@color/secondary_light</item>    <!-- #666666 -->
        <item name="colorSecondaryVariant">@color/secondary</item>   <!-- #444444 -->
        <item name="colorOnSecondary">@color/white</item>

        <!-- Dark background palette -->
        <item name="android:colorBackground">#121212</item>
        <item name="colorSurface">#1E1E1E</item>
        <item name="colorOnSurface">@color/text_on_dark</item>       <!-- #FFFFFF -->

        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Error -->
        <item name="colorError">#CF6679</item>
        <item name="colorOnError">#000000</item>
    </style>

    <style name="ProfileDetailRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">12dp</item>
    </style>

    <style name="ProfileDetailIcon">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:tint">#A855F7</item>
    </style>

    <style name="ProfileDetailTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ProfileDetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A6B0CF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ProfileDetailValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MaterialAlertDialog_Dark" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#18233D</item>          <!-- dialog background -->
        <item name="colorOnSurface">#FFFFFF</item>         <!-- title & message text -->
        <item name="colorPrimary">#8A38F5</item>           <!-- button text color -->
        <item name="buttonBarPositiveButtonStyle">@style/PositiveButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/NegativeButtonStyle</item>
    </style>

    <style name="PositiveButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#8A38F5</item>
    </style>

    <style name="NegativeButtonStyle" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">#A6B0CF</item>
    </style>

    <style name="CustomDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">#18233D</item>
        <item name="colorOnSurface">#FFFFFF</item>
        <item name="colorPrimary">#8A38F5</item>
    </style>

    <style name="InfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingVertical" tools:targetApi="o">4dp</item>
    </style>

    <style name="InfoLabel">
        <item name="android:layout_width">90dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A6B0CF</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="InfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MachineGridLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A6B0CF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="MachineGridValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="PremiumInfoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingVertical">6dp</item>
    </style>

    <style name="PremiumInfoIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:tint">#8A38F5</item>
    </style>

    <style name="PremiumInfoTextContainer">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PremiumInfoLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#A6B0CF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="PremiumInfoValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>