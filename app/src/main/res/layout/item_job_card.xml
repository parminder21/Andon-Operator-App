<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#18233D"
    app:strokeColor="#2D3A56"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: Job ID + Status chip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvJobId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="JOB-20260521-0001"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>

                <TextView
                    android:id="@+id/tvProductName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Part: CAR3453"
                    android:textColor="#A6B0CF"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <!-- Status chip -->
            <LinearLayout
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_status_green"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tvJobStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Not Started"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Middle row: Machine + Floor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_machine"
                    app:tint="#8A38F5"
                    android:layout_marginEnd="6dp"/>

                <TextView
                    android:id="@+id/tvMachineInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ROBO WELDING MACHINE"
                    android:textColor="#A6B0CF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvFloorInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Floor 1"
                android:textColor="#A6B0CF"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"/>
        </LinearLayout>

        <!-- Progress bar: Target vs Actual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <TextView
                    android:id="@+id/tvTarget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Target: 500"
                    android:textColor="#A6B0CF"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvActual"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Actual: 0"
                    android:textColor="#A6B0CF"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvDefective"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Defect: 0"
                    android:textColor="#F44336"
                    android:textSize="12sp"/>
            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:indeterminate="false"
                app:indicatorColor="#8A38F5"
                app:trackColor="#2D3A56"
                app:trackThickness="4dp" />
        </LinearLayout>

        <!-- Datetime row: Start + End -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#4CAF50"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start: --"
                    android:textColor="#A6B0CF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_clock"
                    app:tint="#F44336"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvEndTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End: --"
                    android:textColor="#A6B0CF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Downtime summary row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_downtime_planned"
                    app:tint="#FFC107"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvPlannedDowntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h 0m"
                    android:textColor="#A6B0CF"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_downtime_unplanned"
                    app:tint="#F44336"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvUnplannedDowntime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0h 0m"
                    android:textColor="#A6B0CF"
                    android:textSize="11sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Runtime row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock"
                app:tint="#03A9F4"
                android:layout_marginEnd="4dp"/>

            <TextView
                android:id="@+id/tvTotalRuntime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#A6B0CF"
                android:textSize="11sp"/>
        </LinearLayout>

        <!-- Bottom row: Shift + Priority + Start/Stop buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_shift"
                    app:tint="#FFC107"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:id="@+id/tvShift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Night Shift"
                    android:textColor="#A6B0CF"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="#FFC107"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:background="@drawable/bg_priority_chip"
                android:layout_marginEnd="10dp"/>

            <!-- Stop Job Button (visible only when Running) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopJob"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="STOP JOB"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D32F2F"
                app:cornerRadius="10dp"
                android:paddingHorizontal="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"
                android:layout_marginEnd="8dp"/>

            <!-- Start Job Button (visible only when Not Started) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartJob"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:text="START JOB"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8A38F5"
                app:cornerRadius="10dp"
                app:strokeWidth="0dp"
                android:paddingHorizontal="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>