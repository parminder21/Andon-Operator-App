<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#18233D"
    app:strokeColor="#2D3A56"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Status Indicator -->
        <View
            android:id="@+id/statusIndicator"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/circle_status_green"/>

        <!-- Main Info Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Machine Name -->
            <TextView
                android:id="@+id/tvDetailMachineName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Machine Name"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:maxLines="1"
                android:ellipsize="end"/>

            <!-- Status + Health + Criticality (single row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/tvDetailStatus"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Active" android:textColor="#A6B0CF" android:textSize="13sp"/>

                <TextView android:id="@+id/tvDetailHealth"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="Health: 100%"
                    android:textColor="#8A38F5" android:textSize="13sp" android:textStyle="bold"/>

                <TextView android:id="@+id/tvDetailCriticality"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:text="Criticality: Medium"
                    android:textColor="#FFC107" android:textSize="13sp"/>
            </LinearLayout>

            <!-- Floor + UID (single row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView android:id="@+id/tvDetailFloor"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Floor: Welding Area" android:textColor="#A6B0CF" android:textSize="12sp"/>

                <TextView android:id="@+id/tvDetailUid"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:text="UID: SUBMACH002"
                    android:textColor="#A6B0CF" android:textSize="12sp"/>
            </LinearLayout>

            <!-- Compact grid: 2 columns, many rows, 10sp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <!-- Row 1 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Brand: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailBrand" style="@style/MachineGridValue"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Model: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailModel" style="@style/MachineGridValue"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Mfr: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailManufacturer" style="@style/MachineGridValue"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Purch: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailPurchaseDate" style="@style/MachineGridValue"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 3 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Inst: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailInstallDate" style="@style/MachineGridValue"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Warranty: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailWarranty" style="@style/MachineGridValue"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 4 -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Prev Serv: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailPrevService" style="@style/MachineGridValue"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:text="Next Serv: " style="@style/MachineGridLabel"/>
                        <TextView android:id="@+id/tvDetailNextService" style="@style/MachineGridValue"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>